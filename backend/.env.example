ALLOW_BEARER_AUTH=false

# Límite de intentos (opcional). Por defecto: login 10/15min por email+IP,
# google 10/15min por IP, forgot-password 5/15min por IP.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_GOOGLE_MAX=10
RATE_LIMIT_GOOGLE_WINDOW_MS=900000
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_FORGOT_WINDOW_MS=900000
